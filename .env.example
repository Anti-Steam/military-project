# ============================================================================
# Образец переменных окружения.
#
# Скопируйте этот файл в .env и подставьте свои значения:
#     cp .env.example .env
#
# Файл .env содержит пароли и в репозиторий не попадает (см. .gitignore).
# ============================================================================

# --- База данных ---------------------------------------------------------
# DB_HOST=localhost — приложение обращается к БД через проброшенный порт.
# Порт 5433, а не стандартный 5432: чтобы не конфликтовать с PostgreSQL,
# если он когда-нибудь будет установлен в систему напрямую.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=military
DB_USER=military
DB_PASSWORD=change_me

# --- Приложение ----------------------------------------------------------
APP_PORT=3000
NODE_ENV=development

# --- Часовой пояс --------------------------------------------------------
# Задается ОДИН раз и применяется и к приложению, и к контейнеру БД.
# Время заступления в наряд («10:30», «17:30») — местное время части,
# поэтому пояс должен совпадать во всех компонентах. Если приложение и БД
# работают в разных поясах, отчеты и строевая записка покажут сдвинутое время.
# Значение указывается по базе tzdata: Europe/Moscow, Asia/Krasnoyarsk и т.п.
TZ=Asia/Krasnoyarsk

# Минимальная длина пароля (по умолчанию 10). На время отладки можно
# опустить до 1, перед эксплуатацией строку убрать.
#PASSWORD_MIN_LENGTH=1

# Кука сессии только по HTTPS. На стенде за Nginx с TLS — true.
#SESSION_SECURE=true

# Сессия: неделя с последнего обращения, каждое обращение продлевает срок.
# SESSION_MAX_DAYS — предел от входа, чтобы сессия не жила вечно; 0 — без предела.
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
