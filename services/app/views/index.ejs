<%- include('partials/header', { title }) %>

<h1>Сводка</h1>

<div class="cards">
  <% if (can('personnel.view')) { %>
  <div class="card">
    <div class="card-value"><%= employeeCount %></div>
    <div class="card-label">человек по списку</div>
  </div>
  <% } %>
  <% if (can('duty.view')) { %>
  <div class="card">
    <div class="card-value"><%= dutyTypes.length %></div>
    <div class="card-label">видов нарядов</div>
  </div>
  <div class="card">
    <div class="card-value"><%= duties.length %></div>
    <div class="card-label">последних нарядов в сводке</div>
  </div>
  <% } %>
</div>

<% if (can('duty.view')) { %>
<h2>Виды нарядов</h2>
<table class="table">
  <thead>
    <tr>
      <th>Код</th><th>Наименование</th><th>Заступление</th><th>Отсыпной</th><th>Выходной</th>
    </tr>
  </thead>
  <tbody>
    <% dutyTypes.forEach((t) => { %>
      <tr>
        <td><span class="tag"><%= t.code %></span></td>
        <td><%= t.name %></td>
        <td><%= t.start_time ? t.start_time.slice(0, 5) : '—' %></td>
        <td><%= t.recovery_sleep_days %> сут.</td>
        <td><%= t.recovery_off_days %> сут.</td>
      </tr>
    <% }) %>
  </tbody>
</table>

<h2>Последние наряды</h2>
<% if (duties.length === 0) { %>
  <p class="muted">Нарядов пока нет. <% if (can('duty.create')) { %><a href="/duties">Открыть график</a>.<% } %></p>
<% } else { %>
  <table class="table">
    <thead>
      <tr><th>№</th><th>Вид</th><th>Заступление</th><th>Подразделение</th><th>Состав</th><th>Статус</th></tr>
    </thead>
    <tbody>
      <% duties.forEach((d) => { %>
        <tr>
          <td><a href="/duties/<%= d.id %>">№ <%= d.id %></a></td>
          <td><span class="tag"><%= d.duty_code %></span> <%= d.duty_name %></td>
          <td><%= fmtDateTime(d.starts_at) %></td>
          <td><%= d.unit_short %></td>
          <td><%= d.assigned_count %> чел.</td>
          <td><span class="status status-<%= d.status %>"><%= dutyStatus(d.status) %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<% } %>

<%- include('partials/footer') %>
